#!/usr/bin/env bash

# @describe Scan target with trufflehog and convert results to CSV
# @meta require-tools trufflehog,jq
# @arg target=. Target file or directory to scan
# @option -r --results=verified <TYPE> Results type(s) [verified|unverified|unknown], comma-separated for multiple
# @option -o --output <NAME> Base name for output files (auto-detected if not provided)
# @flag -j --json-only Output only JSONL, skip CSV conversion
# @flag -s --split Also split results into per-detector files after scanning
# @flag -q --quiet Suppress progress output
# @flag -v --verbose Enable verbose output

# ─── Colors ───────────────────────────────────────────────────────────────────

setup_colors() {
  local quiet="${1:-}"
  if [[ "$quiet" == 1 ]] || [[ -z "${TERM:-}" ]] || [[ "$TERM" == "dumb" ]]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" red="" dim=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) red=$(tput setaf 1)
    dim=$(tput dim 2>/dev/null || echo "")
  fi
}

log() { [[ -z "$_quiet" ]] && printf "%s\n" "$*" >&2; }
log_verbose() { [[ -n "$_verbose" ]] && printf "${blue}::${reset} %s\n" "$*" >&2; }
die() { printf "${red}Error:${reset} %s\n" "$*" >&2; exit 1; }

# ─── Shared helpers ───────────────────────────────────────────────────────────

is_archive() {
  local file="$1"
  case "${file,,}" in
    *.zip|*.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.gz|*.bz2|*.xz|*.7z|*.rar) return 0 ;;
    *) return 1 ;;
  esac
}

count_archive_files() {
  local file="$1"
  case "${file,,}" in
    *.zip) unzip -l "$file" 2>/dev/null | tail -1 | awk '{print $2}' ;;
    *.tar) tar -tf "$file" 2>/dev/null | wc -l ;;
    *.tar.gz|*.tgz) tar -tzf "$file" 2>/dev/null | wc -l ;;
    *.tar.bz2|*.tbz2) tar -tjf "$file" 2>/dev/null | wc -l ;;
    *.tar.xz|*.txz) tar -tJf "$file" 2>/dev/null | wc -l ;;
    *.7z) 7z l "$file" 2>/dev/null | grep -c "^[0-9]" ;;
    *) echo 1 ;;
  esac
}

estimate_file_chunks() {
  local file="$1"
  local size
  size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null)
  local chunks=$(( (size + 12000 - 1) / 12000 ))
  [[ $chunks -lt 1 ]] && chunks=1
  echo "$chunks"
}

# ─── Progress UI ──────────────────────────────────────────────────────────────

draw_progress() {
  local current="$1" total="$2" label="$3" width=30
  [[ $total -eq 0 ]] && total=1
  [[ $current -gt $total ]] && current=$total

  local percent=$((current * 100 / total))
  local filled=$((current * width / total))
  local empty=$((width - filled))
  local bar=""

  for ((i=0; i<filled; i++)); do bar+="█"; done
  for ((i=0; i<empty; i++)); do bar+="░"; done

  printf "\r${cyan}[${green}%s${cyan}]${reset} %3d%% (%d/%d %s)" \
    "$bar" "$percent" "$current" "$total" "$label" >&2
}

draw_spinner() {
  local frame="$1" label="$2"
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local spinner="${frames[$((frame % ${#frames[@]}))]}"
  printf "\r${cyan}%s${reset} %s" "$spinner" "$label" >&2
}

draw_spinner_done() {
  local chunks="$1"
  printf "\r${green}✓${reset} Scanned %d chunks\n" "$chunks" >&2
}

# ─── Scan helpers ─────────────────────────────────────────────────────────────

validate_results_type() {
  local results="$1"
  local valid_types=("verified" "unverified" "unknown")
  local result_type
  local input="${results%$'\n'}"

  while IFS= read -r -d',' result_type || [[ -n "$result_type" ]]; do
    result_type="${result_type%$'\n'}"
    result_type="${result_type## }"
    result_type="${result_type%% }"
    [[ -z "$result_type" ]] && continue
    if [[ ! " ${valid_types[*]} " =~ " ${result_type} " ]]; then
      die "Invalid results type: $result_type (valid: verified, unverified, unknown)"
    fi
  done <<< "$input"
}

get_base_name() {
  local target="$1" output="$2"
  if [[ -n "$output" ]]; then
    echo "$output"
  elif [[ -f "$target" ]]; then
    local base
    base=$(basename "$target")
    echo "${base%.*}"
  elif [[ -d "$target" ]]; then
    basename "$target"
  else
    echo "results"
  fi
}

validate_target() {
  local target="$1"
  [[ -e "$target" ]] || die "Target does not exist: $target"
  realpath "$target"
}

count_items() {
  local target="$1"
  if [[ -f "$target" ]]; then
    if is_archive "$target"; then
      count_archive_files "$target"
    else
      estimate_file_chunks "$target"
    fi
  else
    find "$target" -type f 2>/dev/null | wc -l
  fi
}

run_scan() {
  local jsonl_file="$1" target="$2" results="$3"

  log_verbose "Target: $target"
  log_verbose "Results type(s): $results"
  log_verbose "Output: $jsonl_file"

  local total_items item_type is_single_file=false
  total_items=$(count_items "$target")

  if [[ -f "$target" ]] && ! is_archive "$target"; then
    is_single_file=true
    item_type="chunks"
  else
    item_type="files"
  fi

  if [[ -z "$_quiet" ]]; then
    > "$jsonl_file"

    if [[ "$is_single_file" == true ]]; then
      local spinner_frame=0 actual_chunks=0

      {
        while true; do
          draw_spinner "$spinner_frame" "Scanning file..."
          ((spinner_frame++))
          sleep 0.1
        done
      } &
      local spinner_pid=$!

      local stderr_file
      stderr_file=$(mktemp)

      trufflehog filesystem "$target" --results "$results" -j --log-level=0 \
        > "$jsonl_file" 2>"$stderr_file"

      kill "$spinner_pid" 2>/dev/null
      wait "$spinner_pid" 2>/dev/null || true

      actual_chunks=$(grep '"finished scanning"' "$stderr_file" | jq -r '.chunks // 0' 2>/dev/null)
      rm -f "$stderr_file"

      [[ -z "$actual_chunks" || "$actual_chunks" == "0" ]] && actual_chunks=1
      draw_spinner_done "$actual_chunks"
    else
      local fifo log_level
      fifo=$(mktemp -u)
      mkfifo "$fifo"

      if [[ -f "$target" ]] && is_archive "$target"; then
        log_level=3
      else
        log_level=3
      fi

      log "${cyan}Scanning...${reset}"
      draw_progress 0 "$total_items" "$item_type"

      {
        local processed=0
        declare -A seen_files
        while IFS= read -r line; do
          if [[ "$line" == *'"msg":"scanning file"'* ]]; then
            local val
            val="${line#*'"path":"'}"
            val="${val%%\"*}"
            if [[ -n "$val" && "$val" != "$line" && -z "${seen_files[$val]:-}" ]]; then
              seen_files["$val"]=1
              ((processed++))
              draw_progress "$processed" "$total_items" "$item_type"
            fi
          fi
        done < "$fifo"
      } &
      local progress_pid=$!

      trufflehog filesystem "$target" --results "$results" -j --log-level="$log_level" \
        > "$jsonl_file" 2>"$fifo"

      wait "$progress_pid" 2>/dev/null || true
      rm -f "$fifo"

      draw_progress "$total_items" "$total_items" "$item_type"
      printf "\n" >&2
    fi
  else
    if ! trufflehog filesystem "$target" --results "$results" -j 2>/dev/null > "$jsonl_file"; then
      die "Trufflehog scan failed"
    fi
  fi

  # Deduplicate JSONL results
  local raw_count dedup_count
  raw_count=$(wc -l < "$jsonl_file")
  if [[ $raw_count -gt 0 ]]; then
    local tmp_dedup
    tmp_dedup=$(mktemp)
    jq -sc 'unique | .[]' "$jsonl_file" > "$tmp_dedup"
    mv "$tmp_dedup" "$jsonl_file"
  fi
  dedup_count=$(wc -l < "$jsonl_file")

  if [[ $raw_count -ne $dedup_count ]]; then
    log "${green}Found ${bold}${dedup_count}${reset}${green} results${reset} (${raw_count} raw, removed $((raw_count - dedup_count)) dupes)"
  else
    log "${green}Found ${bold}${dedup_count}${reset}${green} results${reset}"
  fi
}

convert_to_csv() {
  local jsonl_file="$1" csv_file="$2"

  log_verbose "Converting to CSV: $csv_file"

  {
    echo '"Verified","DetectorName","Raw","RawV2","ExtraData"'
    jq -r '[
      .Verified,
      .DetectorName,
      (.Raw | gsub("\n"; " ")),
      (.RawV2 // "" | gsub("\n"; " ")),
      (.ExtraData | if . == null then "" else (tostring | gsub("\n"; " ")) end)
    ] | @csv' "$jsonl_file"
  } > "$csv_file"

  if [[ ${PIPESTATUS[0]} -ne 0 ]]; then
    die "CSV conversion failed"
  fi
}

# ─── Split helpers ────────────────────────────────────────────────────────────

# Validate a JSONL file is non-empty trufflehog output
validate_jsonl() {
  local input="$1"
  [[ -f "$input" ]] || die "Input file not found: $input"
  if [[ ! -s "$input" ]] || [[ -z "$(head -c 1 "$input")" ]]; then
    die "Input file is empty: $input"
  fi
  if ! head -1 "$input" | jq -e '.DetectorName' >/dev/null 2>&1; then
    die "Input doesn't look like trufflehog JSONL (missing DetectorName)"
  fi
}

# Build summary JSON from JSONL (single jq pass)
build_summary_json() {
  local input="$1"
  jq -s '
    group_by(.DetectorName)
    | map({
        detector: .[0].DetectorName,
        count: length,
        verified: [.[] | select(.Verified == true)] | length,
        unverified: [.[] | select(.Verified == false)] | length,
        files: [.[].SourceMetadata.Data.Filesystem.file // "unknown"] | unique
    })
    | sort_by(-.count)
  ' "$input"
}

# Print summary table to stderr
print_summary_table() {
  local summary_json="$1"

  printf "\n${bold}%-25s %6s %8s %10s  %s${reset}\n" "DETECTOR" "COUNT" "VERIFIED" "UNVERIFIED" "SOURCE FILES" >&2
  printf "%-25s %6s %8s %10s  %s\n" "-------------------------" "------" "--------" "----------" "-------------------" >&2

  echo "$summary_json" | jq -r '.[] | [.detector, .count, .verified, .unverified, (.files | length)] | @tsv' | \
  while IFS=$'\t' read -r det count ver unver fcount; do
    if [[ "$ver" -gt 0 ]]; then
      ver_str="${red}${bold}${ver}${reset}"
    else
      ver_str="${dim}${ver}${reset}"
    fi
    printf "%-25s %6s %8b %10s  %s file(s)\n" "$det" "$count" "$ver_str" "$unver" "$fcount" >&2
  done

  local verified_total unverified_total detector_count total
  verified_total=$(echo "$summary_json" | jq '[.[].verified] | add')
  unverified_total=$(echo "$summary_json" | jq '[.[].unverified] | add')
  detector_count=$(echo "$summary_json" | jq 'length')
  total=$(echo "$summary_json" | jq '[.[].count] | add')

  printf "\n${bold}Total:${reset} %s results across %s detector types " "$total" "$detector_count" >&2
  if [[ "$verified_total" -gt 0 ]]; then
    printf "(${red}${bold}%s verified${reset}, %s unverified)\n" "$verified_total" "$unverified_total" >&2
  else
    printf "(%s verified, %s unverified)\n" "$verified_total" "$unverified_total" >&2
  fi
}

# Write split files: per-detector .txt, summary.txt, and jsonl/
write_split_files() {
  local input="$1" outdir="$2" summary_json="$3" full_raw="$4"

  log ":: Exporting to ${cyan}${outdir}/${reset}"
  mkdir -p "$outdir"

  local verified_total unverified_total detector_count total
  verified_total=$(echo "$summary_json" | jq '[.[].verified] | add')
  unverified_total=$(echo "$summary_json" | jq '[.[].unverified] | add')
  detector_count=$(echo "$summary_json" | jq 'length')
  total=$(echo "$summary_json" | jq '[.[].count] | add')

  # Write summary.txt
  {
    echo "trfl split summary — $(date -Iseconds)"
    echo "Source: $input"
    echo "Total: $total results across $detector_count detector types"
    echo "Verified: $verified_total | Unverified: $unverified_total"
    echo ""
    printf "%-25s %6s %8s %10s\n" "DETECTOR" "COUNT" "VERIFIED" "UNVERIFIED"
    printf "%-25s %6s %8s %10s\n" "-------------------------" "------" "--------" "----------"
    echo "$summary_json" | jq -r '.[] | [.detector, .count, .verified, .unverified] | @tsv' | \
    while IFS=$'\t' read -r det count ver unver; do
      printf "%-25s %6s %8s %10s\n" "$det" "$count" "$ver" "$unver"
    done
  } > "$outdir/summary.txt"

  # Extract detector names
  local detectors
  detectors=$(echo "$summary_json" | jq -r '.[].detector')

  # Split results into per-detector .txt files (append + dedup)
  while IFS= read -r detector; do
    [[ -z "$detector" ]] && continue

    local safe_name outfile
    safe_name=$(echo "$detector" | tr ' /' '_-')
    outfile="$outdir/${safe_name}.txt"

    # Generate new entries to a temp file
    local tmp_new
    tmp_new=$(mktemp)
    if [[ "$full_raw" == true ]]; then
      jq -r --arg det "$detector" '
        select(.DetectorName == $det) |
        "## [\(if .Verified then "VERIFIED" else "unverified" end)] \(.SourceMetadata.Data.Filesystem.file // "unknown"):\(.SourceMetadata.Data.Filesystem.line // "?")\n" +
        "Raw: \(.Raw | gsub("\n"; "\n     "))\n" +
        if (.RawV2 // "") != "" then "RawV2: \(.RawV2 | gsub("\n"; "\n       "))\n" else "" end +
        if (.ExtraData // {} | length) > 0 then "Extra: \(.ExtraData | tostring)\n" else "" end +
        "---"
      ' "$input" > "$tmp_new"
    else
      jq -r --arg det "$detector" '
        select(.DetectorName == $det) |
        "## [\(if .Verified then "VERIFIED" else "unverified" end)] \(.SourceMetadata.Data.Filesystem.file // "unknown"):\(.SourceMetadata.Data.Filesystem.line // "?")\n" +
        "Redacted: \(.Redacted | if . == "" or . == null then "(empty)" else gsub("\n"; "\n          ") end)\n" +
        if (.ExtraData // {} | length) > 0 then "Extra: \(.ExtraData | tostring)\n" else "" end +
        "---"
      ' "$input" > "$tmp_new"
    fi

    local new_count merged_label
    if [[ -f "$outfile" ]]; then
      # Merge: extract existing entry blocks, combine with new, dedup
      local tmp_existing tmp_merged
      tmp_existing=$(mktemp)
      tmp_merged=$(mktemp)
      # Extract just the entry blocks from existing file (skip # header lines)
      awk '/^## \[/{found=1} found{print}' "$outfile" > "$tmp_existing"
      # Combine existing + new, dedup by whole entry block (## ... through ---)
      cat "$tmp_existing" "$tmp_new" | \
        awk '/^## \[/{if(block) { if(!seen[block]++) printf "%s", block } block=""} {block=block $0 "\n"} END{if(block && !seen[block]++) printf "%s", block}' > "$tmp_merged"
      # Rewrite file with updated header + deduped entries
      {
        echo "# ${detector} — Secrets Report"
        echo "# Updated: $(date -Iseconds)"
        echo "# Source: $input"
        echo ""
        cat "$tmp_merged"
      } > "$outfile"
      new_count=$(grep -c '^## \[' "$tmp_merged" || true)
      merged_label="merged"
      rm -f "$tmp_existing" "$tmp_merged"
    else
      # Fresh file: write header + entries
      {
        echo "# ${detector} — Secrets Report"
        echo "# Generated: $(date -Iseconds)"
        echo "# Source: $input"
        echo ""
        cat "$tmp_new"
      } > "$outfile"
      new_count=$(grep -c '^## \[' "$tmp_new" || true)
      merged_label="new"
    fi
    rm -f "$tmp_new"

    printf "  ${green}✓${reset} %-25s → %s (%s entries, %s)\n" "$detector" "$outfile" "$new_count" "$merged_label" >&2
  done <<< "$detectors"

  # Write per-detector JSONL splits (append + dedup)
  local jsonl_dir="$outdir/jsonl"
  mkdir -p "$jsonl_dir"

  while IFS= read -r detector; do
    [[ -z "$detector" ]] && continue
    local safe_name jsonl_out
    safe_name=$(echo "$detector" | tr ' /' '_-')
    jsonl_out="$jsonl_dir/${safe_name}.jsonl"

    if [[ -f "$jsonl_out" ]] && [[ -s "$jsonl_out" ]]; then
      # Merge existing + new, dedup
      local tmp_merged
      tmp_merged=$(mktemp)
      { cat "$jsonl_out"; jq -c --arg det "$detector" 'select(.DetectorName == $det)' "$input"; } | \
        jq -sc 'unique | .[]' > "$tmp_merged"
      mv "$tmp_merged" "$jsonl_out"
    else
      jq -c --arg det "$detector" 'select(.DetectorName == $det)' "$input" > "$jsonl_out"
    fi
  done <<< "$detectors"

  # Final summary
  local file_count
  file_count=$(find "$outdir" -maxdepth 1 -name "*.txt" -not -name "summary.txt" | wc -l)
  echo "" >&2
  log ":: ${green}Done:${reset} ${bold}${file_count}${reset} detector files + summary → ${cyan}${outdir}/${reset}"
  log ":: JSONL splits → ${cyan}${jsonl_dir}/${reset}"
}

# Core split logic — used by both `split` subcommand and `--split` flag
do_split() {
  local input="$1" outdir="$2" summary_only="$3" full_raw="$4"

  validate_jsonl "$input"

  local total
  total=$(wc -l < "$input")
  [[ "$total" -eq 0 ]] && die "No results in $input"

  log ":: Parsing ${bold}${total}${reset} results from ${cyan}${input}${reset}"

  local summary_json
  summary_json=$(build_summary_json "$input")

  print_summary_table "$summary_json"

  if [[ "$summary_only" == true ]]; then
    return 0
  fi

  # Derive output directory if not provided
  if [[ -z "$outdir" ]]; then
    local input_base input_stem input_dir
    input_base="$(basename "$input")"
    input_stem="${input_base%%.*}"
    input_dir="$(dirname "$input")"
    outdir="${input_dir}/${input_stem}_secrets"
  fi

  write_split_files "$input" "$outdir" "$summary_json" "$full_raw"
}

# ─── Subcommand: split ───────────────────────────────────────────────────────

# @cmd Split JSONL results into per-detector files with summary
# @arg input! Trufflehog JSONL file to split
# @option -o --output <DIR> Output directory (default: <basename>_secrets/)
# @flag -s --summary Print summary only, don't write split files
# @flag -f --full Include full raw secrets (default: redacted)
# @flag -q --quiet Suppress progress output
split() {
  _quiet="${argc_quiet:-}"
  _verbose=""
  setup_colors "$_quiet"

  do_split "$argc_input" "${argc_output:-}" "${argc_summary:+true}" "${argc_full:+true}"
}

# ─── Default command (scan) ───────────────────────────────────────────────────

main() {
  _quiet="${argc_quiet:-}"
  _verbose="${argc_verbose:-}"
  setup_colors "$_quiet"
  validate_results_type "$argc_results"

  local target
  target=$(validate_target "$argc_target")

  local base_name jsonl_file csv_file
  base_name=$(get_base_name "$target" "${argc_output:-}")
  jsonl_file="${base_name}.jsonl"
  csv_file="${base_name}.csv"

  run_scan "$jsonl_file" "$target" "$argc_results"

  if [[ -z "${argc_json_only:-}" ]]; then
    convert_to_csv "$jsonl_file" "$csv_file"
    log "\n${green}Done:${reset} ${cyan}$jsonl_file${reset}, ${cyan}$csv_file${reset}"
  else
    log "\n${green}Done:${reset} ${cyan}$jsonl_file${reset}"
  fi

  # Auto-split if --split flag is set and we have results
  if [[ -n "${argc_split:-}" ]] && [[ -s "$jsonl_file" ]]; then
    local dedup_count
    dedup_count=$(wc -l < "$jsonl_file")
    if [[ "$dedup_count" -gt 0 ]]; then
      echo "" >&2
      do_split "$jsonl_file" "" false false
    fi
  fi
}

# Show help when invoked with no arguments
if [[ $# -eq 0 ]]; then
  set -- --help
fi

# ARGC-BUILD {
# This block was generated by argc (https://github.com/sigoden/argc).
# Modifying it manually is not recommended

_argc_run() {
    if [[ "${1:-}" == "___internal___" ]]; then
        _argc_die "error: unsupported ___internal___ command"
    fi
    if [[ "${OS:-}" == "Windows_NT" ]] && [[ -n "${MSYSTEM:-}" ]]; then
        set -o igncr
    fi
    argc__args=("$(basename "$0" .sh)" "$@")
    argc__positionals=()
    _argc_index=1
    _argc_len="${#argc__args[@]}"
    _argc_tools=()
    _argc_parse
    _argc_require_tools "${_argc_tools[@]}"
    if [ -n "${argc__fn:-}" ]; then
        $argc__fn "${argc__positionals[@]}"
    fi
}

_argc_usage() {
    cat <<-'EOF'
Scan target with trufflehog and convert results to CSV

USAGE: trfl [OPTIONS] <COMMAND>

ARGS:
  [TARGET]  Target file or directory to scan [default: .]

OPTIONS:
  -r, --results <TYPE>  Results type(s) [verified|unverified|unknown], comma-separated for multiple [default: verified]
  -o, --output <NAME>   Base name for output files (auto-detected if not provided)
  -j, --json-only       Output only JSONL, skip CSV conversion
  -s, --split           Also split results into per-detector files after scanning
  -q, --quiet           Suppress progress output
  -v, --verbose         Enable verbose output
  -h, --help            Print help
  -V, --version         Print version

COMMANDS:
  split  Split JSONL results into per-detector files with summary
EOF
    exit
}

_argc_version() {
    echo trfl 0.0.0
    exit
}

_argc_parse() {
    local _argc_key _argc_action
    local _argc_subcmds="split"
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage
            ;;
        --version | -version | -V)
            _argc_version
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --results | -r)
            _argc_take_args "--results <TYPE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_results:-}" ]]; then
                argc_results="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--results\` cannot be used multiple times"
            fi
            ;;
        --output | -o)
            _argc_take_args "--output <NAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_output:-}" ]]; then
                argc_output="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--output\` cannot be used multiple times"
            fi
            ;;
        --json-only | -j)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--json-only\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_json_only:-}" ]]; then
                _argc_die "error: the argument \`--json-only\` cannot be used multiple times"
            else
                argc_json_only=1
            fi
            ;;
        --split | -s)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--split\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_split:-}" ]]; then
                _argc_die "error: the argument \`--split\` cannot be used multiple times"
            else
                argc_split=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        --verbose | -v)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--verbose\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_verbose:-}" ]]; then
                _argc_die "error: the argument \`--verbose\` cannot be used multiple times"
            else
                argc_verbose=1
            fi
            ;;
        split)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_split
            break
            ;;
        help)
            local help_arg="${argc__args[$((_argc_index + 1))]:-}"
            case "$help_arg" in
            split)
                _argc_usage_split
                ;;
            "")
                _argc_usage
                ;;
            *)
                _argc_die "error: invalid value \`$help_arg\` for \`<command>\`"$'\n'"  [possible values: $_argc_subcmds]"
                ;;
            esac
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(trufflehog jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        argc__fn=main
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage
        fi
        _argc_match_positionals 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_target="${argc__positionals[values_index]}"
        else
            argc_target=.
            argc__positionals+=("$argc_target")
        fi
        if [[ -z "${argc_results:-}" ]]; then
            argc_results=verified
        fi
    fi
}

_argc_usage_split() {
    cat <<-'EOF'
Split JSONL results into per-detector files with summary

USAGE: trfl split [OPTIONS] <INPUT>

ARGS:
  <INPUT>  Trufflehog JSONL file to split

OPTIONS:
  -o, --output <DIR>  Output directory (default: <basename>_secrets/)
  -s, --summary       Print summary only, don't write split files
  -f, --full          Include full raw secrets (default: redacted)
  -q, --quiet         Suppress progress output
  -h, --help          Print help
EOF
    exit
}

_argc_parse_split() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage_split
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --output | -o)
            _argc_take_args "--output <DIR>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_output:-}" ]]; then
                argc_output="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--output\` cannot be used multiple times"
            fi
            ;;
        --summary | -s)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--summary\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_summary:-}" ]]; then
                _argc_die "error: the argument \`--summary\` cannot be used multiple times"
            else
                argc_summary=1
            fi
            ;;
        --full | -f)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--full\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_full:-}" ]]; then
                _argc_die "error: the argument \`--full\` cannot be used multiple times"
            else
                argc_full=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(trufflehog jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        argc__fn=split
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage_split
        fi
        _argc_match_positionals 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_input="${argc__positionals[values_index]}"
        else
            _argc_die "error: the required environments \`<INPUT>\` were not provided"
        fi
    fi
}

_argc_take_args() {
    _argc_take_args_values=()
    _argc_take_args_len=0
    local param="$1" min="$2" max="$3" signs="$4" delimiter="$5"
    if [[ "$min" -eq 0 ]] && [[ "$max" -eq 0 ]]; then
        return
    fi
    local _argc_take_index=$((_argc_index + 1)) _argc_take_value
    if [[ "$_argc_item" == *=* ]]; then
        _argc_take_args_values=("${_argc_item##*=}")
    else
        while [[ $_argc_take_index -lt $_argc_len ]]; do
            _argc_take_value="${argc__args[_argc_take_index]}"
            if _argc_maybe_flag_option "$signs" "$_argc_take_value"; then
                if [[ "${#_argc_take_value}" -gt 1 ]]; then
                    break
                fi
            fi
            _argc_take_args_values+=("$_argc_take_value")
            _argc_take_args_len=$((_argc_take_args_len + 1))
            if [[ "$_argc_take_args_len" -ge "$max" ]]; then
                break
            fi
            _argc_take_index=$((_argc_take_index + 1))
        done
    fi
    if [[ "${#_argc_take_args_values[@]}" -lt "$min" ]]; then
        _argc_die "error: incorrect number of values for \`$param\`"
    fi
    if [[ -n "$delimiter" ]] && [[ "${#_argc_take_args_values[@]}" -gt 0 ]]; then
        local item values arr=()
        for item in "${_argc_take_args_values[@]}"; do
            IFS="$delimiter" read -r -a values <<<"$item"
            arr+=("${values[@]}")
        done
        _argc_take_args_values=("${arr[@]}")
    fi
}

_argc_match_positionals() {
    _argc_match_positionals_values=()
    _argc_match_positionals_len=0
    local params=("$@")
    local args_len="${#argc__positionals[@]}"
    if [[ $args_len -eq 0 ]]; then
        return
    fi
    local params_len=$# arg_index=0 param_index=0
    while [[ $param_index -lt $params_len && $arg_index -lt $args_len ]]; do
        local takes=0
        if [[ "${params[param_index]}" -eq 1 ]]; then
            if [[ $param_index -eq 0 ]] &&
                [[ ${_argc_dash:-} -gt 0 ]] &&
                [[ $params_len -eq 2 ]] &&
                [[ "${params[$((param_index + 1))]}" -eq 1 ]] \
                ; then
                takes=${_argc_dash:-}
            else
                local arg_diff=$((args_len - arg_index)) param_diff=$((params_len - param_index))
                if [[ $arg_diff -gt $param_diff ]]; then
                    takes=$((arg_diff - param_diff + 1))
                else
                    takes=1
                fi
            fi
        else
            takes=1
        fi
        _argc_match_positionals_values+=("$arg_index:$takes")
        arg_index=$((arg_index + takes))
        param_index=$((param_index + 1))
    done
    if [[ $arg_index -lt $args_len ]]; then
        _argc_match_positionals_values+=("$arg_index:$((args_len - arg_index))")
    fi
    _argc_match_positionals_len=${#_argc_match_positionals_values[@]}
    if [[ $params_len -gt 0 ]] && [[ $_argc_match_positionals_len -gt $params_len ]]; then
        local index="${_argc_match_positionals_values[params_len]%%:*}"
        _argc_die "error: unexpected argument \`${argc__positionals[index]}\` found"
    fi
}

_argc_maybe_flag_option() {
    local signs="$1" arg="$2"
    if [[ -z "$signs" ]]; then
        return 1
    fi
    local cond=false
    if [[ "$signs" == *"+"* ]]; then
        if [[ "$arg" =~ ^\+[^+].* ]]; then
            cond=true
        fi
    elif [[ "$arg" == -* ]]; then
        if (( ${#arg} < 3 )) || [[ ! "$arg" =~ ^---.* ]]; then
            cond=true
        fi
    fi
    if [[ "$cond" == "false" ]]; then
        return 1
    fi
    local value="${arg%%=*}"
    if [[ "$value" =~ [[:space:]] ]]; then
        return 1
    fi
    return 0
}

_argc_require_tools() {
    local tool missing_tools=()
    for tool in "$@"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
    if [[ "${#missing_tools[@]}" -gt 0 ]]; then
        echo "error: missing tools: ${missing_tools[*]}" >&2
        exit 1
    fi
}

_argc_die() {
    if [[ $# -eq 0 ]]; then
        cat
    else
        echo "$*" >&2
    fi
    exit 1
}

_argc_run "$@"

# ARGC-BUILD }
